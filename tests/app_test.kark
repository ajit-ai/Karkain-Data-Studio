func test_dataset_record_parse() {
    let rec = "sales|3|3|1,10,5;2,20,6;3,30,7"
    let f = split(rec, "|")
    assert_eq(len(f), 4)
    assert_eq(f[0], "sales")
    assert_eq(int(f[1]), 3)
    assert_eq(int(f[2]), 3)
    assert_eq(len(split(f[3], ";")), 3)
}

func test_transform_column_math() {
    let rows = split("1,10,5;2,20,6;3,30,7", ";")
    let out = ""
    let r = 0
    while (r < len(rows)) {
        let cells = split(rows[r], ",")
        let row = ""
        let c = 0
        while (c < len(cells)) {
            if (c > 0) { row = row + "," }
            if (c == 1) { row = row + str(int(cells[c]) * 2) } else { row = row + cells[c] }
            c = c + 1
        }
        if (r > 0) { out = out + ";" }
        out = out + row
        r = r + 1
    }
    let final = split(out, ";")
    assert_eq(len(final), 3)
    assert_eq(split(final[0], ",")[1], "20")
    assert_eq(split(final[2], ",")[1], "60")
}

func test_upsert_replaces_existing() {
    let state = ["a|1|2|1,2", "b|1|2|3,4"]
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "a") { push(out, "a|1|2|9,9"); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    assert_eq(replaced, 1)
    assert_eq(len(out), 2)
    assert_eq(split(out[0], "|")[3], "9,9")
}
