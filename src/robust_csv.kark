// Karkain Data Studio - Round 2: robust CSV workspace.
// Adds header validation, per-column numeric/text detection, WHERE-style
// filtering (col op value), multi-step transformations and export of the
// current filtered view. Uses only verified builtins and relative paths.
// State lives in data/r2_state.dat; it never touches Round 1 files.

func find_ds(state, name) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == name) { return state[i] }
        i = i + 1
    }
    return ""
}

func put_ds(state, name, header, types, rows, view) {
    let rec = name + "|" + header + "|" + types + "|" + rows + "|" + view
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == name) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func is_int(s) {
    let t = trim(s)
    if (t == "") { return 0 }
    if (str(int(t)) == t) { return 1 }
    return 0
}

func detect_types(header, rows) {
    let ncol = len(split(header, ","))
    let out = ""
    let c = 0
    while (c < ncol) {
        let allnum = 1
        if (rows != "EMPTY") {
            let rl = split(rows, ";")
            let r = 0
            while (r < len(rl)) {
                let cells = split(rl[r], ",")
                if (c < len(cells)) {
                    if (is_int(cells[c]) == 0) { allnum = 0 }
                }
                r = r + 1
            }
        }
        if (c > 0) { out = out + "," }
        if (allnum == 1) { out = out + "N" } else { out = out + "T" }
        c = c + 1
    }
    return out
}

// Returns "OK|header|types|rows" or "ERR|reason".
func validate_and_load(path) {
    let txt = readFile(path)
    if (txt == "") { return "ERR|cannot read " + path }
    let lines = split(txt, "\n")
    let header = ""
    let ncol = 0
    let rows = ""
    let nrow = 0
    let err = ""
    let i = 0
    while (i < len(lines) && err == "") {
        let line = trim(lines[i])
        if (line != "") {
            let cells = split(line, ",")
            if (header == "") {
                header = line
                ncol = len(cells)
                let c = 0
                while (c < len(cells)) {
                    if (trim(cells[c]) == "") { err = "empty header name" }
                    c = c + 1
                }
                let a = 0
                while (a < len(cells) && err == "") {
                    let b = a + 1
                    while (b < len(cells) && err == "") {
                        if (trim(cells[a]) == trim(cells[b])) { err = "duplicate header name" }
                        b = b + 1
                    }
                    a = a + 1
                }
            } else {
                if (len(cells) != ncol) {
                    err = "column count mismatch at row " + str(nrow + 1)
                } else {
                    let row = ""
                    let c = 0
                    while (c < len(cells)) {
                        if (c > 0) { row = row + "," }
                        row = row + trim(cells[c])
                        c = c + 1
                    }
                    if (nrow > 0) { rows = rows + ";" }
                    rows = rows + row
                    nrow = nrow + 1
                }
            }
        }
        i = i + 1
    }
    if (err != "") { return "ERR|" + err }
    if (nrow == 0) { return "ERR|no data rows" }
    return "OK|" + header + "|" + detect_types(header, rows) + "|" + rows
}

func rowcount(rows) {
    if (rows == "EMPTY") { return 0 }
    return len(split(rows, ";"))
}

func compare_cell(cell, op, value, numeric) {
    let ok = 0
    if (numeric == 1) {
        let a = int(cell)
        let b = int(value)
        if (op == "EQ") { if (a == b) { ok = 1 } }
        if (op == "NE") { if (a != b) { ok = 1 } }
        if (op == "GT") { if (a > b) { ok = 1 } }
        if (op == "LT") { if (a < b) { ok = 1 } }
        if (op == "GE") { if (a >= b) { ok = 1 } }
        if (op == "LE") { if (a <= b) { ok = 1 } }
    } else {
        if (op == "EQ") { if (cell == value) { ok = 1 } }
        if (op == "NE") { if (cell != value) { ok = 1 } }
        if (op == "GT") { if (cell > value) { ok = 1 } }
        if (op == "LT") { if (cell < value) { ok = 1 } }
        if (op == "GE") { if (cell >= value) { ok = 1 } }
        if (op == "LE") { if (cell <= value) { ok = 1 } }
    }
    return ok
}

func apply_step_row(row, col, op, arg) {
    let cells = split(row, ",")
    let out = ""
    let c = 0
    while (c < len(cells)) {
        if (c > 0) { out = out + "," }
        let v = cells[c]
        if (c == col) {
            if (op == "MUL") { v = str(int(v) * int(arg)) }
            if (op == "ADD") { v = str(int(v) + int(arg)) }
            if (op == "SET") { v = arg }
            if (op == "TRIM") { v = trim(v) }
        }
        out = out + v
        c = c + 1
    }
    return out
}

func r2_persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

public func r2_run() {
    let cmds = split(readFile("data/r2_commands.dat"), "\n")
    let state = split(readFile("data/r2_state.dat"), "\n")
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "LOAD2") {
                let res = validate_and_load(f[2])
                let p = split(res, "|")
                if (p[0] == "ERR") {
                    let msg = "HEADER_ERR " + f[1] + " reason=" + p[1]
                    print(msg)
                    report = report + msg + "\n"
                } else {
                    state = put_ds(state, f[1], p[1], p[2], p[3], p[3])
                    let msg = "LOAD2 " + f[1] + " rows=" + str(rowcount(p[3])) + " cols=" + str(len(split(p[1], ",")))
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "HEADER") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let msg = "HEADER " + f[1] + " cols=" + str(len(split(d[1], ","))) + " names=" + d[1] + " valid=1"
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "TYPES") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let tt = split(d[2], ",")
                    let num = 0
                    let txt = 0
                    let k = 0
                    while (k < len(tt)) {
                        if (tt[k] == "N") { num = num + 1 } else { txt = txt + 1 }
                        k = k + 1
                    }
                    let msg = "TYPES " + f[1] + " " + d[2] + " numeric=" + str(num) + " text=" + str(txt)
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "WHERE") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let col = int(f[2])
                    let types = split(d[2], ",")
                    let numeric = 0
                    if (col < len(types)) {
                        if (types[col] == "N") { numeric = 1 }
                    }
                    let source = split(d[3], ";")
                    let view = ""
                    let matched = 0
                    let r = 0
                    while (r < len(source)) {
                        let cells = split(source[r], ",")
                        if (col < len(cells)) {
                            if (compare_cell(cells[col], f[3], f[4], numeric) == 1) {
                                if (matched > 0) { view = view + ";" }
                                view = view + source[r]
                                matched = matched + 1
                            }
                        }
                        r = r + 1
                    }
                    if (matched == 0) { view = "EMPTY" }
                    state = put_ds(state, f[1], d[1], d[2], d[3], view)
                    let msg = "WHERE " + f[1] + " col=" + f[2] + " op=" + f[3] + " value=" + f[4] + " matched=" + str(matched)
                    print(msg)
                    report = report + msg + "\n"
                }
            }
            if (op == "VIEW") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let msg = "VIEW " + f[1] + " rows=" + str(rowcount(d[4]))
                    print(msg)
                    report = report + msg + "\n"
                    if (d[4] != "EMPTY") {
                        let vr = split(d[4], ";")
                        let r = 0
                        while (r < len(vr)) {
                            let vm = "VROW " + vr[r]
                            print(vm)
                            report = report + vm + "\n"
                            r = r + 1
                        }
                    }
                }
            }
            if (op == "MULTI") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let steps = split(f[2], ";")
                    let rows = split(d[3], ";")
                    let cur = d[3]
                    let s = 0
                    while (s < len(steps)) {
                        let sp = split(steps[s], ":")
                        let col = int(sp[0])
                        let sop = sp[1]
                        let arg = sp[2]
                        let next = ""
                        let r = 0
                        while (r < len(rows)) {
                            if (r > 0) { next = next + ";" }
                            next = next + apply_step_row(rows[r], col, sop, arg)
                            r = r + 1
                        }
                        cur = next
                        rows = split(cur, ";")
                        let sm = "STEP " + f[1] + " " + steps[s] + " rows=" + str(len(rows))
                        print(sm)
                        report = report + sm + "\n"
                        s = s + 1
                    }
                    state = put_ds(state, f[1], d[1], d[2], cur, cur)
                }
            }
            if (op == "EXPORT_VIEW") {
                let rec = find_ds(state, f[1])
                if (rec == "") {
                    print("ERROR unknown dataset " + f[1])
                } else {
                    let d = split(rec, "|")
                    let out = ""
                    if (d[4] != "EMPTY") {
                        let vr = split(d[4], ";")
                        let r = 0
                        while (r < len(vr)) {
                            out = out + vr[r] + "\n"
                            r = r + 1
                        }
                    }
                    writeFile(f[2], out)
                    let msg = "EXPORT_VIEW " + f[1] + " -> " + f[2] + " rows=" + str(rowcount(d[4]))
                    print(msg)
                    report = report + msg + "\n"
                }
            }
        }
        i = i + 1
    }
    r2_persist("data/r2_state.dat", state)
    r2_persist("data/r2_report.dat", split(report, "\n"))
    print("R2_DATA_STUDIO_OK datasets=" + str(len(state)))
}
